{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": [".env", ".env.*"],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env", ".env.*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": ["NEXT_PUBLIC_*"]
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env", ".env.*"],
      "outputs": [],
      "env": ["CI"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["*"]
    },
    "openapi": {
      "cache": false,
      "outputs": ["openapi.json"]
    },
    "orval": {
      "dependsOn": ["api#openapi"],
      "cache": false,
      "outputs": ["src/lib/api/**"]
    },
    "codegen": {
      "dependsOn": ["web#orval"],
      "cache": false
    },
    "db:generate": {
      "cache": false
    },
    "db:schema": {
      "cache": false
    },
    "db:reset": {
      "cache": false
    },
    "db:drift": {
      "cache": false
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    },
    "format": {
      "cache": false
    }
  }
}
