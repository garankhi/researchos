{
  "openapi": "3.0.0",
  "paths": {
    "/demo/slow": {
      "get": {
        "operationId": "DemoController_getSlow",
        "parameters": [
          {
            "name": "delay",
            "required": false,
            "in": "query",
            "description": "Milliseconds to wait before answering. Capped at 30000.",
            "schema": {
              "example": 2000,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Greeting message",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DemoControllerGetSlowEnvelope"
                }
              }
            }
          }
        },
        "summary": "Returns the greeting after a configurable delay",
        "tags": [
          "demo"
        ]
      }
    },
    "/demo/fail": {
      "get": {
        "operationId": "DemoController_getFail",
        "parameters": [],
        "responses": {
          "500": {
            "description": "The request always fails.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponseDto"
                }
              }
            }
          }
        },
        "summary": "Always fails with a 500 to exercise the error state",
        "tags": [
          "demo"
        ]
      }
    },
    "/demo/unstable": {
      "get": {
        "operationId": "DemoController_getUnstable",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Greeting message",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DemoControllerGetUnstableEnvelope"
                }
              }
            }
          }
        },
        "summary": "Alternates between success and failure",
        "tags": [
          "demo"
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "HealthController_check",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Service status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatusDtoEnvelope"
                }
              }
            }
          }
        },
        "summary": "Liveness probe for the API process",
        "tags": [
          "health"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "HealthController_checkReadiness",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Service status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatusDtoEnvelope"
                }
              }
            }
          }
        },
        "summary": "Readiness probe including a database round trip",
        "tags": [
          "health"
        ]
      }
    },
    "/auth/login": {
      "post": {
        "operationId": "AuthController_login",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The signed-in user payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeDtoEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "The credential was rejected.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponseDto"
                }
              }
            }
          }
        },
        "summary": "Signs in with a local credential and issues a session cookie",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "AuthController_logout",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The session was revoked.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LogoutDtoEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "There is no session to revoke.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponseDto"
                }
              }
            }
          }
        },
        "summary": "Revokes the session behind the current cookie",
        "tags": [
          "auth"
        ]
      }
    },
    "/me": {
      "get": {
        "operationId": "AuthController_me",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The current user payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeDtoEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "There is no valid session behind the request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Returns the current user payload",
        "tags": [
          "auth"
        ]
      }
    },
    "/jobs/probes": {
      "post": {
        "operationId": "JobsController_create",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateProbeDto"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Durably accepted; poll statusUrl.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobDtoEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid diagnostic parameters.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "A valid session is required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponseDto"
                }
              }
            }
          },
          "403": {
            "description": "Requires ADMIN.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponseDto"
                }
              }
            }
          },
          "409": {
            "description": "Idempotency key was already used with different input.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Submits an admin diagnostic job through the transactional outbox",
        "tags": [
          "jobs"
        ]
      }
    },
    "/jobs/{id}": {
      "get": {
        "operationId": "JobsController_find",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Logical job UUID returned on submission.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current durable status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobDtoEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid job UUID.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "A valid session is required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponseDto"
                }
              }
            }
          },
          "404": {
            "description": "Job is missing or belongs to another user.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Returns the requesting user’s durable job status",
        "tags": [
          "jobs"
        ]
      }
    },
    "/jobs/{id}/retry": {
      "post": {
        "operationId": "JobsController_retry",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Failed logical job UUID.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Reprocessing accepted; poll statusUrl.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobDtoEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid job UUID.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "A valid session is required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponseDto"
                }
              }
            }
          },
          "403": {
            "description": "Requires ADMIN; ownership is still required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponseDto"
                }
              }
            }
          },
          "404": {
            "description": "Job is missing or belongs to another user.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponseDto"
                }
              }
            }
          },
          "409": {
            "description": "Only failed jobs can be reprocessed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Reprocesses an owned failed job in a new bounded generation",
        "tags": [
          "jobs"
        ]
      }
    }
  },
  "info": {
    "title": "ResearchOS API",
    "description": "ResearchOS backend API",
    "version": "0.0.1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "HealthStatusDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok",
            "description": "ok when healthy, degraded when a dependency is unreachable"
          },
          "service": {
            "type": "string",
            "example": "researchos-api",
            "description": "Name of the service that answered the probe."
          },
          "uptimeSeconds": {
            "type": "number",
            "example": 42,
            "description": "Process uptime in seconds"
          },
          "timestamp": {
            "type": "string",
            "example": "2026-10-29T01:30:00.000Z",
            "description": "ISO timestamp of when the probe answered."
          }
        },
        "required": [
          "status",
          "service",
          "uptimeSeconds",
          "timestamp"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "The account's email address. It is normalized before the lookup, so the case and the surrounding spaces do not matter.",
            "example": "faculty@researchos.local"
          },
          "password": {
            "type": "string",
            "description": "The account's password.",
            "example": "ResearchOS!Dev2026"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "MeDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The account's id.",
            "example": "1f0d2f2e-6f0a-4a2f-9f6b-2d1c9a3b7e11"
          },
          "email": {
            "type": "string",
            "description": "The account's email address, normalized.",
            "example": "faculty@researchos.local"
          },
          "fullName": {
            "type": "string",
            "description": "The account's display name.",
            "example": "Dev Faculty"
          },
          "userType": {
            "type": "string",
            "description": "The kind of account.",
            "enum": [
              "FACULTY",
              "STUDENT",
              "STAFF"
            ],
            "example": "FACULTY"
          },
          "departmentUnit": {
            "type": "string",
            "description": "The department or unit the account belongs to.",
            "example": "FPTU"
          },
          "academicTitle": {
            "type": "string",
            "description": "The account's academic title, when it has one.",
            "example": "PGS",
            "nullable": true
          },
          "academicDegree": {
            "type": "string",
            "description": "The account's academic degree, when it has one.",
            "example": "TS",
            "nullable": true
          },
          "roles": {
            "type": "array",
            "description": "The roles the account currently holds. `RESEARCHER` and `ADMIN` are the two roles; a faculty account is a researcher through the baseline rule, without an explicit grant.",
            "items": {
              "type": "string",
              "enum": [
                "RESEARCHER",
                "ADMIN"
              ]
            },
            "example": [
              "RESEARCHER"
            ]
          },
          "onboardingCompleted": {
            "type": "boolean",
            "description": "Whether the account finished the onboarding. A missing profile row means false — it never creates one.",
            "example": true
          },
          "profileConfirmed": {
            "type": "boolean",
            "description": "Whether the account confirmed its profile. A missing profile row means false.",
            "example": true
          },
          "mustChangePassword": {
            "type": "boolean",
            "description": "Whether the account must change its password before it can use the rest of the API.",
            "example": false
          }
        },
        "required": [
          "id",
          "email",
          "fullName",
          "userType",
          "departmentUnit",
          "academicTitle",
          "academicDegree",
          "roles",
          "onboardingCompleted",
          "profileConfirmed",
          "mustChangePassword"
        ]
      },
      "LogoutDto": {
        "type": "object",
        "properties": {
          "revoked": {
            "type": "boolean",
            "description": "Whether a session was revoked.",
            "example": true
          }
        },
        "required": [
          "revoked"
        ]
      },
      "CreateProbeDto": {
        "type": "object",
        "properties": {
          "idempotencyKey": {
            "type": "string",
            "description": "Caller-generated UUID; repeated submissions by this owner reuse the job.",
            "format": "uuid"
          },
          "failuresBeforeSuccess": {
            "type": "number",
            "description": "Diagnostic failures before success in generation zero; 3 exhausts the bounded retry policy.",
            "minimum": 0,
            "maximum": 3,
            "default": 0
          }
        },
        "required": [
          "idempotencyKey"
        ]
      },
      "JobDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Durable logical job identifier.",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "description": "PENDING includes queued, running and retrying work; terminal states are persisted in PostgreSQL.",
            "enum": [
              "PENDING",
              "COMPLETED",
              "FAILED"
            ]
          },
          "attempts": {
            "type": "number",
            "description": "Execution attempts in the current generation.",
            "minimum": 0,
            "maximum": 3
          },
          "statusUrl": {
            "type": "string",
            "description": "Owner-scoped URL to poll for this job."
          }
        },
        "required": [
          "id",
          "status",
          "attempts",
          "statusUrl"
        ]
      },
      "ApiErrorResponseDto": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              false
            ],
            "default": false
          },
          "data": {
            "nullable": true,
            "enum": [
              null
            ]
          },
          "message": {
            "type": "string",
            "description": "The error code, e.g. `opportunity_not_found`."
          },
          "statusCode": {
            "type": "number"
          },
          "path": {
            "type": "string"
          },
          "timestamp": {
            "type": "string"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string"
                },
                "messages": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "field",
                "messages"
              ]
            }
          }
        },
        "required": [
          "success",
          "data",
          "message",
          "statusCode",
          "path",
          "timestamp"
        ]
      },
      "DemoControllerGetSlowEnvelope": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              true
            ],
            "default": true
          },
          "data": {
            "type": "string"
          },
          "message": {
            "type": "string",
            "default": ""
          }
        },
        "required": [
          "success",
          "data",
          "message"
        ]
      },
      "DemoControllerGetUnstableEnvelope": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              true
            ],
            "default": true
          },
          "data": {
            "type": "string"
          },
          "message": {
            "type": "string",
            "default": ""
          }
        },
        "required": [
          "success",
          "data",
          "message"
        ]
      },
      "HealthStatusDtoEnvelope": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              true
            ],
            "default": true
          },
          "data": {
            "$ref": "#/components/schemas/HealthStatusDto"
          },
          "message": {
            "type": "string",
            "default": ""
          }
        },
        "required": [
          "success",
          "data",
          "message"
        ]
      },
      "MeDtoEnvelope": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              true
            ],
            "default": true
          },
          "data": {
            "$ref": "#/components/schemas/MeDto"
          },
          "message": {
            "type": "string",
            "default": ""
          }
        },
        "required": [
          "success",
          "data",
          "message"
        ]
      },
      "LogoutDtoEnvelope": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              true
            ],
            "default": true
          },
          "data": {
            "$ref": "#/components/schemas/LogoutDto"
          },
          "message": {
            "type": "string",
            "default": ""
          }
        },
        "required": [
          "success",
          "data",
          "message"
        ]
      },
      "JobDtoEnvelope": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              true
            ],
            "default": true
          },
          "data": {
            "$ref": "#/components/schemas/JobDto"
          },
          "message": {
            "type": "string",
            "default": ""
          }
        },
        "required": [
          "success",
          "data",
          "message"
        ]
      }
    }
  }
}
