# Environment variables for the NestJS worker.
#
# Values are inherited from the workspace root `.env`. Use this file only to
# override them for this app. Copy to `.env` and edit as needed.

# Standalone worker: no HTTP port is needed.
# Override only if this app uses a different Redis host than the root .env.
# REDIS_URL="redis://localhost:6379"
# QUEUE_PREFIX=researchos

# Scheduled opportunity expiry uses the same queue prefix on every worker.
# OPPORTUNITY_EXPIRY_INTERVAL_MS=60000
# OPPORTUNITY_EXPIRY_BATCH_SIZE=250
# RES-174. Set the 64-character digest of the local qwen3-embedding:0.6b model
# to enable Topic suggestions. Copy it from Ollama's /api/tags response.
# OLLAMA_EMBEDDING_DIGEST=
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# Enable only on workers intended to send real digest mail through Gmail SMTP.
DIGEST_SMTP_ENABLED=false
# DIGEST_SMTP_USER="demo-account@gmail.com"
# DIGEST_SMTP_APP_PASSWORD="your-google-app-password"
