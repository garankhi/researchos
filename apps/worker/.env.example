# Environment variables for the NestJS worker.
#
# Values are inherited from the workspace root `.env`. Use this file only to
# override them for this app. Copy to `.env` and edit as needed.

# Standalone worker: no HTTP port is needed.
# Override only if this app uses a different Redis host than the root .env.
# REDIS_URL="redis://localhost:6379"
# QUEUE_PREFIX=researchos
