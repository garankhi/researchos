    "@tanstack/react-query": "^5.105.0",
    "axios": "^1.21.0",
    "lucide-react": "1.72.0",
    "next": "16.4.3",
    "next-intl": "4.14.9",
    "next-themes": "0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
