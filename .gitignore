# Keep the original SRS and other source documents local.
docs/*
!docs/*.md
!docs/adr/
!docs/adr/*.md
!docs/database/
!docs/database/*.md
!docs/database/*.dbml
!docs/database/*.sql
!docs/database/*.ps1
!docs/database/*.py
!docs/database/*.cjs

# Dependencies and generated output.
**/node_modules/
**/.next/
**/dist/
**/build/
**/out/
**/coverage/
**/*.tsbuildinfo
.pnpm-store/
**/.turbo/
**/.cache/
**/.swc/
**/.vercel/
.eslintcache

# Generated Prisma client. It is rebuilt from prisma/schema.prisma by
# `pnpm db:generate` and by the prebuild step of @researchos/database.
packages/database/src/generated/

# Local configuration.
.env
.env.*
!.env.example
!.env.*.example
*.log

# Operating system metadata.
.DS_Store
Thumbs.db
Desktop.ini
