# Environment variables shared by the whole workspace.
#
# The API and the worker read this file. Values here are overridden by an
# app-local `.env` file in `apps/api/` or `apps/worker/`.
#
# Copy this file to `.env` and fill in your own credentials. `.env` is
# ignored by Git.

# Local Docker dependencies. These credentials are for local development only.
# If you change the password or port, update DATABASE_URL to match.
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=55432
REDIS_PORT=6379

# PostgreSQL connection string used by Prisma and by the application.
DATABASE_URL="postgresql://postgres:postgres@localhost:55432/researchos?schema=public"

# Reserved for the first BullMQ integration; the worker is still a scaffold.
REDIS_URL="redis://localhost:6379"

# Optional. A separate database that `prisma migrate dev` applies migrations
# to. Leave unset to let Prisma create and drop a temporary database instead.
# SHADOW_DATABASE_URL="postgresql://postgres:postgres@localhost:55432/researchos_shadow?schema=public"

# Origin allowed to call the API from a browser. Comma separated.
WEB_ORIGIN="http://localhost:3000"

# Port the NestJS API listens on.
PORT=4000
