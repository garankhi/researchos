# Environment variables shared by the whole workspace.
#
# The API and the worker read this file. Values here are overridden by an
# app-local `.env` file in `apps/api/` or `apps/worker/`.
#
# Copy this file to `.env` and fill in your own credentials. `.env` is
# ignored by Git.

# PostgreSQL connection string used by the application.
#
# The port is 5433 because a native PostgreSQL 17 Windows service already
# listens on 5432. The Docker container in docker-compose.yml keeps 5432
# internally and publishes 5433.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/researchos?schema=public"

# Redis connection string used by BullMQ. Matches the redis service in
# docker-compose.yml.
REDIS_URL="redis://localhost:6379"

# Origin allowed to call the API from a browser. Comma separated.
WEB_ORIGIN="http://localhost:3000"

# Port the NestJS API listens on.
PORT=4000
