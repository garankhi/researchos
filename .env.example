# Environment variables shared by the whole workspace.
#
# The API and the worker read this file. Values here are overridden by an
# app-local `.env` file in `apps/api/` or `apps/worker/`.
#
# Copy this file to `.env` and fill in your own credentials. `.env` is
# ignored by Git.

# Local Docker dependencies. These credentials are for local development only.
# If you change the password or port, update DATABASE_URL to match.
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=55432
REDIS_PORT=6379

# SeaweedFS S3 endpoint for local object storage. If you change S3_PORT,
# update S3_ENDPOINT to match. These credentials are for local use only.
S3_PORT=8333
S3_ENDPOINT="http://localhost:8333"
S3_BUCKET=researchos-local
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=researchos-local
S3_SECRET_ACCESS_KEY=researchos-local-secret
# API only. Generate a secret of at least 32 bytes for upload confirmation.
# S3_UPLOAD_TOKEN_SECRET=

# PostgreSQL connection string used by Prisma and by the application.
DATABASE_URL="postgresql://postgres:postgres@localhost:55432/researchos?schema=public"

# Redis used by the API producer and standalone BullMQ worker.
REDIS_URL="redis://localhost:6379"
# Optional namespace; API and worker must use the same value.
# A custom prefix also needs researchos.research_updates_queue_prefix on the database.
# QUEUE_PREFIX=researchos

# Optional Article PDF enrichment. Set the URL in apps/worker/.env to opt in.
# ARTICLE_PDF_GROBID_URL=http://127.0.0.1:8070
# ARTICLE_PDF_GROBID_TIMEOUT_MS=4000
# GROBID_PORT=8070

# Optional. A separate database that `prisma migrate dev` applies migrations
# to. Leave unset to let Prisma create and drop a temporary database instead.
# SHADOW_DATABASE_URL="postgresql://postgres:postgres@localhost:55432/researchos_shadow?schema=public"

# Optional. Contact address the OpenAlex client sends in its user agent
# (the polite pool). Falls back to dev@researchos.local when unset.
# OPENALEX_MAILTO=dev@researchos.local

# Origins allowed to call the API and local S3 from a browser. Comma separated.
WEB_ORIGIN="http://localhost:3000"

# Port the NestJS API listens on.
PORT=4000
# Optional Firebase Cloud Messaging settings. The private key belongs on the worker.
# NOTIFICATION_FCM_ENABLED=false
# NOTIFICATION_FCM_PROJECT_ID=
# NOTIFICATION_FCM_CLIENT_EMAIL=
# NOTIFICATION_FCM_PRIVATE_KEY=
# Public Firebase project settings for the Next.js build.
# NEXT_PUBLIC_FCM_API_KEY=
# NEXT_PUBLIC_FCM_PROJECT_ID=
# NEXT_PUBLIC_FCM_SENDER_ID=
# NEXT_PUBLIC_FCM_APP_ID=
# NEXT_PUBLIC_FCM_VAPID_KEY=

# Optional. The OpenAlex API key lifts the client out of the anonymous
# pool, which shares one daily budget across everyone on the network's
# IP address. Without it the workspace shares that budget with everyone
# else. Falls back to the anonymous pool when unset.
# OPENALEX_API_KEY=
