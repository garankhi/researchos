// ResearchOS v4.3 - FPTU internal research network - 2026-10-30
// Paste this entire file into dbdiagram.io.
// PostgreSQL-only partial/GIN indexes, role view and timestamp triggers are
// included in ResearchOS.sql. This diagram is not an authorization engine.
Project researchos {
  database_type: 'PostgreSQL'
  Note: '''Fresh database design. MVP uses provisioned email/password accounts; OIDC is a future alternative on the same user. Active faculty are researchers; students/staff need a RESEARCHER grant. ADMIN is independent and does not bypass resource ownership/visibility. Personal output releases require output ownership, not group approval. Group leaders accept a pinned released revision for their group only. Other creates LOCAL topics immediately. Taxonomy: OpenAlex Field -> Subfield -> Topic, without Domain. SQL adds constraints, triggers and query helpers; backend authenticates the actor and applies authorization.'''
}

Enum user_type { 
  FACULTY
  STUDENT
  STAFF
}
Enum access_role {
  RESEARCHER
  ADMIN
}
Enum handover_basis {
  HOLDER_CONSENT
  INSTITUTIONAL_AUTHORIZATION
}
Enum role_grant_source {
  MANUAL
  SYSTEM
}
Enum authentication_method {
  LOCAL
  OIDC
}
Enum taxonomy_source {
  LOCAL
  OPENALEX
}
Enum visibility_level {
  PRIVATE
  RESEARCH_GROUP
  FPTU_COMMUNITY
}
Enum data_provenance_type {
  PAPER
  AI_TRACE
  AI_INF
  HUMAN
  EXT
  UNK
}
Enum interest_source {
  DECLARED
  INFERRED
}
Enum interest_status {
  SUGGESTED
  ACTIVE
  REJECTED
}
Enum claim_status {
  SUGGESTED
  CONFIRMED
  REJECTED
}
Enum availability_status_type {
  OPEN_FOR_COLLABORATION
  SEEKING_GROUP
  MENTORING_ONLY
  LIMITED_AVAILABILITY
  NOT_AVAILABLE
}
Enum group_member_role {
  CORE_MEMBER
  COLLABORATOR
  STUDENT_MEMBER
}
Enum post_type {
  GENERAL_NEWS
  PUBLICATION
  AWARD
  PROJECT_UPDATE
}
Enum opportunity_kind {
  RESEARCH_COLLABORATION
  PROJECT_FORMATION
  DATA_METHOD_EXCHANGE
  FUNDING_CALL
}
Enum target_audience {
  FACULTY
  STUDENT
  ANY_RESEARCHER
}
Enum opportunity_status {
  DRAFT
  OPEN
  FILLED
  CLOSED
  EXPIRED
}
Enum opportunity_application_status {
  PENDING
  INVITED_TO_DISCUSS
  DECLINED
  WITHDRAWN
}
Enum expected_role_type {
  CO_PI
  METHODOLOGY_LEAD
  DOMAIN_EXPERT
  DATA_ENGINEER
  STUDENT_RESEARCHER
  CO_AUTHOR
  ADVISOR_CONSULTANT
}
Enum project_type {
  UNIVERSITY_GRANT
  MINISTRY_GRANT
  STATE_GRANT
  INDUSTRY_LAB
  INTERNATIONAL_JOINT
  COLLABORATIVE_RESEARCH
}
Enum milestone_status {
  ON_TRACK
  DELAYED
  BLOCKED
  COMPLETED
}
Enum project_status {
  PROPOSAL_DRAFT
  APPROVED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  PUBLISHED_DELIVERED
