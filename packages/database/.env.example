# Connection string for the Prisma CLI and for the application runtime.
#
# The credentials match the postgres service in docker-compose.yml.
# The port is 5433 because a native PostgreSQL 17 Windows service already
# listens on 5432; the container publishes 5433.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/researchos?schema=public"

# Redis connection string used by BullMQ.
REDIS_URL="redis://localhost:6379"

# The database schema comes from ResearchOS.sql, not from Prisma Migrate.
# Regenerate the Prisma datamodel from the live database with:
#   pnpm --filter @researchos/database db:schema
