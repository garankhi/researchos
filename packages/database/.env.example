# Connection string for the Prisma CLI and for the application runtime.
# Normally use the root .env with Docker; a package-local .env is optional.
DATABASE_URL="postgresql://postgres:postgres@localhost:55432/researchos?schema=public"

# Optional. A separate database that `prisma migrate dev` applies migrations
# to. Leave unset to let Prisma create and drop a temporary database instead.
# SHADOW_DATABASE_URL="postgresql://postgres:postgres@localhost:55432/researchos_shadow?schema=public"
