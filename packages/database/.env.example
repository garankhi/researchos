# Connection string for the Prisma CLI and for the application runtime.
# Replace user/password with the credentials of your local PostgreSQL install.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/researchos?schema=public"

# Optional. A separate database that `prisma migrate dev` applies migrations
# to. Leave unset to let Prisma create and drop a temporary database instead.
# SHADOW_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/researchos_shadow?schema=public"
