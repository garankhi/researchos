generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

/// Generic audit trail. Every domain table that records a meaningful change
/// references an entry here so that provenance is queryable.
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?  @map("actor_id")
  action    String   @db.VarChar(64)
  entity    String   @db.VarChar(64)
  entityId  String   @map("entity_id")
  payload   Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([entity, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model background_jobs {
  queue_prefix    String   @default("researchos") @db.VarChar(128)
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_id        String   @db.Uuid
  kind            String   @db.VarChar(64)
  idempotency_key String   @db.VarChar(128)
  payload         Json
  status          String   @default("PENDING") @db.VarChar(16)
  generation      Int      @default(0)
  attempts        Int      @default(0)
  result          Json?
  error_code      String?  @db.VarChar(64)
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @default(now()) @db.Timestamptz(6)
  users           users    @relation(fields: [owner_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  outbox          outbox[]

  @@unique([owner_id, kind, idempotency_key], map: "uq_background_job_request")
}

model outbox {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  job_id          String          @db.Uuid
  generation      Int
  destination     String          @default("WORK") @db.VarChar(16)
  available_at    DateTime        @default(now()) @db.Timestamptz(6)
  dispatched_at   DateTime?       @db.Timestamptz(6)
  background_jobs background_jobs @relation(fields: [job_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([job_id, generation, destination], map: "uq_outbox_delivery")
  @@index([available_at], map: "idx_outbox_ready", where: raw("(dispatched_at IS NULL)"))
}

model achievement_posts {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id           String             @db.Uuid
  group_id          String?            @db.Uuid
  project_id        String?            @db.Uuid
  output_id         String?            @db.Uuid
  title             String             @db.VarChar(255)
  post_type         post_type          @default(GENERAL_NEWS)
  content           String
  award_issuer      String?            @db.VarChar(255)
  award_year        Int?
  created_at        DateTime           @default(now()) @db.Timestamptz(6)
  research_groups   research_groups?   @relation(fields: [group_id], references: [id], onUpdate: NoAction)
  research_outputs  research_outputs?  @relation(fields: [output_id], references: [id], onUpdate: NoAction)
  research_projects research_projects? @relation(fields: [project_id], references: [id], onUpdate: NoAction)
  users             users              @relation(fields: [user_id], references: [id], onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
