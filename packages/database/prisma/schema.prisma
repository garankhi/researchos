/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model digest_deliveries {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id             String          @db.Uuid
  period_start        DateTime        @db.Timestamptz(6)
  period_end          DateTime        @db.Timestamptz(6)
  status              delivery_status @default(PENDING)
  attempts            Int             @default(0)
  next_attempt_at     DateTime        @default(now()) @db.Timestamptz(6)
  locked_until        DateTime?       @db.Timestamptz(6)
  provider_message_id String?
  last_error          String?
  sent_at             DateTime?       @db.Timestamptz(6)
  created_at          DateTime        @default(now()) @db.Timestamptz(6)
  users               users           @relation(fields: [user_id], references: [id], onUpdate: NoAction)
  digest_items        digest_items[]

  @@unique([user_id, period_start, period_end], map: "digest_deliveries_user_id_period_start_period_end_idx")
  @@index([locked_until], map: "idx_digest_lease", where: raw("(status = 'PROCESSING'::delivery_status)"))
  @@index([next_attempt_at], map: "idx_digest_ready", where: raw("(status = ANY (ARRAY['PENDING'::delivery_status, 'FAILED'::delivery_status]))"))
}

