// ResearchOS data model.
//
// Ownership rules for this file:
// - Every table lives in the `public` schema. No schema-per-tenant.
// - Enums are declared next to the models that use them, not in a shared dump.
// - Three independent axes are tracked separately, per docs/architecture.md:
//   `validationStatus`, `visibility` and `publicationStatus`. Never collapse
//   them into one `status` field.
// - Every record that can be user-entered, imported or AI-inferred keeps its
//   provenance: `sourceKind`, `sourceRef` and `verificationStatus`.
// - Timestamps are stored in UTC. `createdAt`/`updatedAt` are mandatory.
//
// Opportunity mappings follow docs/database/ResearchOS.sql. That SQL remains
// the baseline for domain tables, foreign keys, functions and CHECK constraints.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Shared building blocks
// ---------------------------------------------------------------------------

/// Where a piece of data came from. Self-declared data is not trusted by
/// default; imported and AI-inferred rows are always reviewable.
enum SourceKind {
  SELF_DECLARED
  IMPORTED
  AI_INFERRED
  SYSTEM
}

/// How far a row has been verified by someone with authority.
enum VerificationStatus {
  UNVERIFIED
  PENDING_REVIEW
  VERIFIED
  REJECTED
}

/// Who may see a record. Independent from publication and validation state.
enum Visibility {
  PRIVATE
  GROUP
  INSTITUTION
  PUBLIC
}

/// Whether a record is considered published. Independent from visibility and
/// validation state.
enum PublicationStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

/// Generic audit trail. Every domain table that records a meaningful change
/// references an entry here so that provenance is queryable.
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?  @map("actor_id")
  action    String   @db.VarChar(64)
  entity    String   @db.VarChar(64)
  entityId  String   @map("entity_id")
  payload   Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([entity, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

enum OpportunityKind {
  RESEARCH_COLLABORATION
  PROJECT_FORMATION
  DATA_METHOD_EXCHANGE
  FUNDING_CALL

  @@map("opportunity_kind")
}

enum TargetAudience {
  FACULTY
  STUDENT
  ANY_RESEARCHER

  @@map("target_audience")
}

enum OpportunityStatus {
  DRAFT
  OPEN
  FILLED
  CLOSED
  EXPIRED

  @@map("opportunity_status")
}

model ResearchOpportunity {
  id                    String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupId               String?           @map("group_id") @db.Uuid
  projectId             String?           @map("project_id") @db.Uuid
  creatorId             String            @map("creator_id") @db.Uuid
  title                 String            @db.VarChar(255)
  opportunityKind       OpportunityKind   @map("opportunity_kind")
  targetAudience        TargetAudience    @default(ANY_RESEARCHER) @map("target_audience")
  expectedRole          String?           @map("expected_role") @db.VarChar(255)
  requiredExpertiseTags String[]          @map("required_expertise_tags")
  description           String?
  responseSlaDays       Int               @default(5) @map("response_sla_days")
  applicationDeadline   DateTime?         @map("application_deadline") @db.Timestamptz(6)
  status                OpportunityStatus @default(DRAFT)
  publishedAt           DateTime?         @map("published_at") @db.Timestamptz(6)
  archivedAt            DateTime?         @map("archived_at") @db.Timestamptz(6)
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createIdempotencyKey  String?           @map("create_idempotency_key") @db.VarChar(200)
  createRequestHash     String?           @map("create_request_hash") @db.Char(64)
  createResponse        Json?             @map("create_response")

  @@unique([creatorId, createIdempotencyKey], map: "uq_opportunity_creator_create_key")
  @@map("research_opportunities")
}
